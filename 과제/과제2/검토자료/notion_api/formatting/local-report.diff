-<tr><td><pre class="source-code"><code>int allocate_memory(MemoryList *list, int pid, int size)
-{
-    if (list == NULL || pid &lt;= 0 || size &lt;= 0)
-    {
-        return 0;
-    }
-    if (find_process_block(list, pid) != NULL)
-    {
-        return 0;
-    }
-
