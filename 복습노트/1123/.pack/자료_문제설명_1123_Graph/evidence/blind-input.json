\" y=\"130\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"sans-serif\" font-size=\"22\" fill=\"#17212b\">B</text></g><g id=\"p6-problem-0-ch11-q02-network-C\"><circle cx=\"650\" cy=\"110\" r=\"22\" fill=\"#fff\" stroke=\"#26394a\" stroke-width=\"2\"/><text x=\"650\" y=\"110\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"sans-serif\" font-size=\"22\" fill=\"#17212b\">C</text></g><g id=\"p6-problem-0-ch11-q02-network-D\"><circle cx=\"130\" cy=\"280\" r=\"22\" fill=\"#fff\" stroke=\"#26394a\" stroke-width=\"2\"/><text x=\"130\" y=\"280\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"sans-serif\" font-size=\"22\" fill=\"#17212b\">D</text></g><g id=\"p6-problem-0-ch11-q02-network-E\"><circle cx=\"600\" cy=\"270\" r=\"22\" fill=\"#fff\" stroke=\"#26394a\" stroke-width=\"2\"/><text x=\"600\" y=\"270\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"sans-serif\" font-size=\"22\" fill=\"#17212b\">E</text></g><g id=\"p6-problem-0-ch11-q02-network-F\"><circle cx=\"360\" cy=\"370\" r=\"22\" fill=\"#fff\" stroke=\"#26394a\" stroke-width=\"2\"/><text x=\"360\" y=\"370\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"sans-serif\" font-size=\"22\" fill=\"#17212b\">F</text></g><g id=\"p6-problem-0-ch11-q02-network-G\"><circle cx=\"670\" cy=\"460\" r=\"22\" fill=\"#fff\" stroke=\"#26394a\" stroke-width=\"2\"/><text x=\"670\" y=\"460\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-family=\"sans-serif\" font-size=\"22\" fill=\"#17212b\">G</text></g></svg></div><figcaption>원문의 그래프</figcaption></figure>",
