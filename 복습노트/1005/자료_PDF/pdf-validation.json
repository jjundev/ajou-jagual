          "html": "<pre><code>#include &lt;stdio.h&gt;\n#include &lt;stdlib.h&gt;\n\ntypedef struct Node { int data; struct Node *link; } Node;\nint count_nodes(Node *head) {\n    int count = 0;\n    for (Node *p = head; p != NULL; p = p-&gt;link) ++count;\n    return count;\n}\nint main(void) {\n    int n, value;\n    Node *head = NULL, *tail = NULL;\n    if (scanf(&quot;%d&quot;, &amp;n) != 1 || n &lt; 0) return 1;\n    for (int i = 0; i &lt; n; ++i) {\n        if (scanf(&quot;%d&quot;, &amp;value) != 1) return 1;\n        Node *p = malloc(sizeof *p);\n        if (p == NULL) return 1;\n        p-&gt;data = value;\n        p-&gt;link = NULL;\n        if (tail == NULL) head = p;\n        else tail-&gt;link = p;\n        tail = p;\n    }\n    printf(&quot;%d\\n&quot;, count_nodes(head));\n    while (head != NULL) {\n        Node *next = head-&gt;link;\n        free(head);\n        head = next;\n    }\n    return 0;\n}</code></pre>",
          "text": "#include <stdio.h>\n#include <stdlib.h>\n\ntypedef struct Node { int data; struct Node *link; } Node;\nint count_nodes(Node *head) {\n    int count = 0;\n    for (Node *p = head; p != NULL; p = p->link) ++count;\n    return count;\n}\nint main(void) {\n    int n, value;\n    Node *head = NULL, *tail = NULL;\n    if (scanf(\"%d\", &n) != 1 || n < 0) return 1;\n    for (int i = 0; i < n; ++i) {\n        if (scanf(\"%d\", &value) != 1) return 1;\n        Node *p = malloc(sizeof *p);\n        if (p == NULL) return 1;\n        p->data = value;\n        p->link = NULL;\n        if (tail == NULL) head = p;\n        else tail->link = p;\n        tail = p;\n    }\n    printf(\"%d\\n\", count_nodes(head));\n    while (head != NULL) {\n        Node *next = head->link;\n        free(head);\n        head = next;\n    }\n    return 0;\n}"
