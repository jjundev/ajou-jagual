        "example": "stack-c",
        "taught_on": "1012",
        "extra_pages": []
      },
      "objectives": [
        "배열 스택 push의 ++(s->top)과 pop의 (s->top)-- 식 평가값 및 인덱스 갱신 원리",
        "top++와 --top 오용 시 인덱스 -1 범위 밖 접근(미정의 동작) 판정"
      ],
      "task_family": "stack-c"
    },
