    {
      "id": "ch02-q16",
      "chapter_id": "ch02",
      "number": "16",
      "kind": "code-write",
      "content": [
        {
          "type": "text",
          "text": "다음의 순환적인 프로그램을 반복 구조를 사용한 비순환적 프로그램으로 바꾸시오."
        },
        {
          "type": "code",
          "language": "c",
          "text": "int sum(int n)\n{\n    if(n == 1 ) return 1;\n    else return (n + sum(n-1));\n}"
        }
      ],
