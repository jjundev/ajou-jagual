      "kind": "choice",
      "content": [
        {
          "type": "text",
          "text": "체이닝에서 새로운 키를 삽입하는 시간은 무엇에 비례하는가?"
        }
      ],
      "options": [
        {
          "label": "1",
          "content": [
            {
              "type": "text",
              "text": "적재율"
            }
          ]
        },
        {
          "label": "2",
          "content": [
            {
              "type": "text",
              "text": "테이블에 있는 전체 항목의 개수"
            }
          ]
        },
        {
          "label": "3",
          "content": [
            {
              "type": "text",
              "text": "버킷의 연결 리스트의 항목의 개수"
            }
          ]
        },
        {
          "label": "4",
          "content": [
            {
              "type": "text",
              "text": "테이블의 크기"
            }
          ]
        }
      ],
      "source_refs": [
        {
          "source_id": "s14",
          "pdf_page": 2,
          "book_page": null
        }
      ],
