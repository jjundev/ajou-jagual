{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "required": [
    "schema_version",
    "sources",
    "chapters",
    "questions",
    "assets"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "page_count"
      ],
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "number",
        "title",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "sourceRef": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "pdf_page": {
          "type": "integer",
          "minimum": 1
        },
        "book_page": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "source_id",
        "pdf_page",
        "book_page"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "verified",
            "blocked"
          ]
        },
        "payload_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "locator",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "payload_sha256",
        "notes"
      ],
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "code"
            },
            "language": {
              "enum": [
                "c",
                "text"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "language",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "figure",
                "table"
              ]
            },
            "asset_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "asset_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "subquestions"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/block"
                    }
                  }
                },
                "required": [
                  "id",
                  "label",
                  "content"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false
        }
      ]
    },
    "issue": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "unreadable",
            "figure-incomplete",
            "source-error",
            "external-context"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "description",
        "source_refs",
        "blocking"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "handwriting",
            "selection-mark",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      },
      "required": [
        "kind",
        "description",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "chapter_id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "pattern": "^0*[1-9][0-9]*$"
        },
        "kind": {
          "enum": [
            "choice",
            "short",
            "trace",
            "code-read",
            "code-write",
            "essay",
            "mixed"
          ]
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/block"
                }
              }
            },
            "required": [
              "label",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "answer": {
          "type": "null"
        },
        "printed_answer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "content": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/block"
                  }
                },
                "source_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/sourceRef"
                  }
                }
              },
              "required": [
                "content",
                "source_refs"
              ],
              "additionalProperties": false
            }
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "required": [
        "id",
        "chapter_id",
        "number",
        "kind",
        "content",
        "options",
        "source_refs",
        "answer",
        "printed_answer",
        "observations",
        "issues",
        "review"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "model_id",
        "alt",
        "source_refs",
        "review"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "tree",
            "graph",
            "array",
            "table",
            "vector"
          ]
        },
        "data": {
          "type": "object"
        },
        "layout": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "data",
        "layout"
      ],
      "additionalProperties": false
    },
    "chapterPart": {
      "type": "object",
      "properties": {
        "chapter": {
          "$ref": "#/$defs/chapter"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "required": [
        "chapter",
        "questions",
        "assets",
        "models"
      ],
      "additionalProperties": false
    }
  }
}
