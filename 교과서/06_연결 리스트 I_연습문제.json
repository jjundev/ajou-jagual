      "options": [
        {
          "label": "1",
          "content": [
            {
              "type": "text",
              "text": "last == NULL"
            }
          ]
        },
        {
          "label": "2",
          "content": [
            {
              "type": "text",
              "text": "last->data == NULL"
            }
          ]
        },
        {
          "label": "3",
          "content": [
            {
              "type": "text",
              "text": "last->link == NULL"
            }
          ]
        },
        {
          "label": "4",
          "content": [
            {
              "type": "text",
              "text": "last->link->link == NULL"
