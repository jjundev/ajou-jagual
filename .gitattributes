# Preserve verbatim source-reading evidence, including original whitespace.
복습노트/**/evidence/source-reading.txt -whitespace
# Keep command-output evidence verbatim.
docs/verify/review-overhaul-20261017/*.log -whitespace
# Preserve the official font license byte-for-byte.
.agents/skills/ds-review-pack/assets/pdf/vendor/jetbrains-mono/OFL.txt -whitespace

# Frozen PDF assets are hashed bytes; keep LF on Windows checkouts.
.agents/skills/ds-review-pack/assets/pdf/**/*.html text eol=lf
.agents/skills/ds-review-pack/assets/pdf/**/*.py text eol=lf
.agents/skills/ds-review-pack/assets/pdf/**/*.css text eol=lf
.agents/skills/ds-review-pack/assets/pdf/**/*.js text eol=lf
.agents/skills/ds-review-pack/assets/pdf/**/*.json text eol=lf
.agents/skills/ds-review-pack/assets/pdf/**/LICENSE text eol=lf
.agents/skills/ds-review-pack/assets/pdf/**/OFL.txt text eol=lf
# Preserve context-line whitespace in saved verification diffs.
docs/verify/exam-restore-20261017/*.patch -whitespace

# Hashed verification sources must survive Windows checkout byte-for-byte.
복습노트/**/evidence/*.c text eol=lf
복습노트/**/evidence/*.py text eol=lf
docs/verify/exam-restore-20261017/*.c text eol=lf
docs/verify/exam-restore-20261017/*.py text eol=lf
docs/verify/no-exam-coverage-20261017/*.c text eol=lf
docs/verify/no-exam-coverage-20261017/*.py text eol=lf

# Shared explanation assets are pinned by SHA-256.
복습노트/_assets/problem-explain/** -text

# Published explanation assets/evidence are hash-bound verbatim copies.
# Preserve their existing bytes rather than rewriting mixed historical EOLs.
